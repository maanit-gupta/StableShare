# StableShare mock server settings (all optional; defaults shown).
# The server reads these from the process environment and does not load .env files itself,
# so export them in your shell, e.g. `PORT=9090 npm run dev`, or `set -a; . ./.env; set +a; npm run dev`.

# Port and interface to listen on.
PORT=8080
HOST=0.0.0.0

# Where seeded files, upload sessions and completed uploads are stored (relative to server/).
STORAGE_DIR=./storage

# Piece size used when a manifest request has no ?chunkSize= (bytes; 2 MiB).
DEFAULT_CHUNK_SIZE=2097152

# Idle upload sessions expire after this many milliseconds (24 h).
SESSION_TTL_MS=86400000

# Set to 0 to turn off per-request logging.
LOG_REQUESTS=1

# Largest upload accepted at session init, in bytes (default 1 GiB; larger gets 413 FILE_TOO_LARGE).
MAX_UPLOAD_BYTES=1073741824

# The settings below are off when unset; fly.toml turns them on for the hosted server.

# Also delete completed uploads (and their hash-index entry) older than this many milliseconds.
# COMPLETED_UPLOAD_TTL_MS=86400000

# Set to 1 to create or repair the seed files in the background at every start.
# SEED_ON_START=1

# Reset fault settings to the defaults after this many milliseconds without an /admin call.
# FAULT_AUTO_RESET_MS=1800000

# Set to 1 to remove POST /admin/files/:fileId/mutate (it then returns 404).
# DISABLE_FILE_MUTATE=1
