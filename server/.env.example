# StableShare mock server settings (all optional; defaults shown).
# The server reads these from the process environment and does not load .env files itself,
# so export them in your shell, e.g. `PORT=9090 npm run dev`, or `set -a; . ./.env; set +a; npm run dev`.

# Port and interface to listen on.
PORT=8080
HOST=0.0.0.0

# Where seeded files, upload sessions and completed uploads are stored (relative to server/).
STORAGE_DIR=./storage

# Piece size used when a manifest request has no ?chunkSize= (bytes; 2 MiB).
DEFAULT_CHUNK_SIZE=2097152

# Idle upload sessions expire after this many milliseconds (24 h).
SESSION_TTL_MS=86400000

# Set to 0 to turn off per-request logging.
LOG_REQUESTS=1
