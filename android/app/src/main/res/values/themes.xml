<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light only (UI-SPEC §0.5); Compose draws everything, edge to edge. -->
    <style name="Theme.StableShare" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/neutral_page</item>
    </style>

    <!-- System splash (UI-SPEC §5.1): mint background, launcher foreground as the icon. -->
    <style name="Theme.StableShare.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_mint</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.StableShare</item>
    </style>
</resources>
