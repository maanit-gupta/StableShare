<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup is disabled (allowBackup="false"): a restored transfer database
   without its part files and URI grants would be inconsistent. These rules exclude every domain
   for Android 12+ cloud backup and device transfer as well.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
